# Supabase — get these from your Supabase project's API settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key — NEVER expose this client-side
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin panel credentials — set a strong password
ADMIN_PASSWORD=your-secure-password-here

# JWT signing secret — generate a random 32+ character string
ADMIN_JWT_SECRET=your-random-secret-here-at-least-32-chars
